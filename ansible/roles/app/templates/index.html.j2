<!doctype html>
<!-- Managed by Ansible (app role) — placeholder kiosk page. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kiosk OK</title>
  <style>
    html, body { height: 100%; margin: 0; }
    body {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      font-family: system-ui, sans-serif;
      background: #0f172a; color: #e2e8f0; text-align: center;
    }
    h1 { font-size: 8vmin; margin: 0 0 2vmin; }
    .clock { font-size: 12vmin; font-variant-numeric: tabular-nums; color: #38bdf8; }
    .meta { margin-top: 4vmin; font-size: 3vmin; color: #94a3b8; }
  </style>
</head>
<body>
  <h1>Kiosk is running ✓</h1>
  <div class="clock" id="clock">--:--:--</div>
  <div class="meta">
    host: {{ ansible_hostname }} &middot; serving from nginx on this device
  </div>
  <script>
    // A live clock proves the page is actually rendering and updating,
    // not just a frozen screenshot.
    function tick() {
      document.getElementById('clock').textContent =
        new Date().toLocaleTimeString();
    }
    setInterval(tick, 1000);
    tick();
  </script>
</body>
</html>
