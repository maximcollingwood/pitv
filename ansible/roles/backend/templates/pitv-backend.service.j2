# Managed by Ansible — edit the template, not this file.
[Unit]
Description=PITV library catalog API
After=network.target

[Service]
User={{ backend_user }}
Group={{ backend_user }}
WorkingDirectory={{ backend_root }}
Environment=PORT={{ backend_port }}
Environment=DB_PATH={{ db_path }}
EnvironmentFile=-/etc/kiosk/admin.env
EnvironmentFile=-/etc/kiosk/youtube.env
ExecStart=/usr/bin/node {{ backend_root }}/dist/index.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
