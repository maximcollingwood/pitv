# Managed by Ansible — edit the template, not this file.
[Unit]
Description=PiTV native kiosk (Qt Quick + libmpv)
After=systemd-user-sessions.service pitv-backend.service
Wants=pitv-backend.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User={{ kiosk_user }}
Group={{ kiosk_user }}

# PAMName=login + TTYPath give the service user a real logind session on tty1,
# which grants seat0 (DRM/input) access and auto-creates XDG_RUNTIME_DIR.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes

# The colour range can only change while nothing holds the display, so it is
# applied as root just before labwc starts. "-" keeps a failure from blocking the TV.
ExecStartPre=-+/usr/local/sbin/pitv-hdmi-range
ExecStart=/usr/local/bin/kiosk-launch.sh

# Self-healing: restart the app whenever it exits or crashes.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
