# Managed by Ansible — edit the template, not this file.
[Unit]
Description=Web kiosk (labwc + Chromium)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User={{ kiosk_user }}
Group={{ kiosk_user }}

# PAMName=login + TTYPath give the service user a real logind session on tty1,
# which grants seat0 (DRM/input) access and auto-creates XDG_RUNTIME_DIR.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes

ExecStart=/usr/local/bin/kiosk-launch.sh

# Self-healing: restart the app whenever it exits or crashes.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
