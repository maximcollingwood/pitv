#!/bin/sh
# Managed by Ansible — edit the template, not this file.
# Started by kiosk.service. Launches the labwc compositor; labwc's autostart
# then brings up the kiosk app, and a labwc keybinding provides the console
# escape hatch.
set -eu

export XDG_RUNTIME_DIR="/run/user/{{ kiosk_uid }}"

# Use the transparent cursor theme installed by the display role so the mouse
# pointer is invisible everywhere on the kiosk.
export XCURSOR_THEME=blank
export XCURSOR_SIZE=1

# A previous session's relaunch loop and app can outlive a service restart (they
# run in the login session scope). Stop them so only one player runs.
pkill -u "$(id -u)" -f '^/bin/sh /usr/local/bin/kiosk-app.sh' || true
pkill -u "$(id -u)" -x pitv-native || true

exec labwc -C /etc/kiosk/labwc
