#!/bin/sh
# Managed by Ansible. The compositor survives native app restarts.
set -u
export PITV_API_URL="http://127.0.0.1:{{ backend_port }}"
# Run as an X11 client on labwc's Xwayland (DISPLAY comes from labwc).
# Bookworm's qml6glsink (GStreamer 1.22, Qt 6.4) cannot attach to a Wayland
# display, so video only renders through the X11/GLX path.
export QT_QPA_PLATFORM=xcb
export QSG_RHI_BACKEND=opengl
export QT_QUICK_CONTROLS_STYLE=Basic
# labwc's children live in the login session, not kiosk.service, so a service
# restart does not stop this loop. Exit once the compositor that started it is
# gone (labwc exports LABWC_PID to the processes it launches).
compositor=${LABWC_PID:-}
while [ -z "$compositor" ] || kill -0 "$compositor" 2>/dev/null; do
  /usr/local/bin/pitv-native
  sleep 2
done
