{
  "name": "pitv",
  "private": true,
  "version": "0.1.0",
  "description": "Native PiTV appliance, media service and phone companion",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "predev": "npm --workspace server run init-db",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace app run dev",
    "build": "npm --workspace server run build && npm --workspace app run build",
    "typecheck": "npm --workspace app run typecheck && npm --workspace server run build",
    "test": "npm --workspace server test",
    "native:configure": "cmake -S native -B native/build -DCMAKE_BUILD_TYPE=Release",
    "native:build": "cmake --build native/build --parallel 2",
    "native:test": "ctest --test-dir native/build --output-on-failure"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
